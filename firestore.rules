rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurações da empresa: qualquer pessoa pode ler (ex: exibir logo/dados em comprovantes públicos)
    match /company_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra padrão: Apenas usuários autenticados têm acesso de leitura e escrita
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
