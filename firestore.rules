rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurações da empresa: leitura e escrita liberadas para o painel
    match /company_settings/{settingId} {
      allow read, write: if true;
    }

    // Catálogo de serviços: leitura pública, edição apenas autenticada
    match /service_catalog/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra padrão: Apenas usuários autenticados têm acesso a clientes, ordens, finanças, etc.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
