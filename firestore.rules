rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurações da empresa: leitura e escrita liberadas para o painel
    match /company_settings/{settingId} {
      allow read, write: if true;
    }

    // Regra padrão: Apenas usuários autenticados têm acesso de leitura e escrita
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
