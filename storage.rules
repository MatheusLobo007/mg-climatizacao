rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de ordens de serviço (Antes/Depois) e anexos
    match /service_orders/{allPaths=**} {
      allow read: if true; // Permite visualização em laudos e orçamentos compartilhados
      allow write: if request.auth != null; // Apenas técnicos autenticados podem enviar fotos
    }

    // Regra geral
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
